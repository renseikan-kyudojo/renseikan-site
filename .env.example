# Copy to .env for local builds; on Vercel these are Environment Variables. Never commit .env.
# Sanity (Content system runbook)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
SANITY_READ_TOKEN=
# Vercel deploy hook URL, so the daily cron (api/daily.ts) rebuilds the site and the class dates roll forward
VERCEL_DEPLOY_HOOK=
# A secret the cron sends so nobody else can trigger /api/daily
CRON_SECRET=
# Optional, for the Instagram feed (not rendered yet): a long-lived token from the Instagram API with Instagram Login
INSTAGRAM_TOKEN=
