# Copy to .env for local builds; on Vercel these are Environment Variables. Never commit .env.
# Sanity (Content system runbook)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
SANITY_READ_TOKEN=
# Instagram (Connections runbook): a long-lived token from the Instagram API with Instagram Login
INSTAGRAM_TOKEN=
INSTAGRAM_USER_ID=
# Vercel deploy hook URL, so the daily cron rebuilds the site after refreshing Instagram
VERCEL_DEPLOY_HOOK=
# A secret the cron sends so nobody else can trigger /api/instagram
CRON_SECRET=
