---
// What a first class looks like, in steps (three fit a row), from the Home page document in the Studio.
import type { Pages } from '../lib/pages';
interface Props {
  copy: Pages['home']['expect'];
}
const { copy } = Astro.props;
---

<h3 class="steps-title">{copy.subtitle}</h3>
<p class="steps-lede">{copy.lede}</p>
<div class="steps">
  {copy.steps.map((s) => (
    <div class="step">
      <p class="jp" lang="ja" aria-hidden="true">
        {s.kanji}
      </p>
      <h3>{s.title}</h3>
      <p class="muted">{s.text}</p>
    </div>
  ))}
</div>
