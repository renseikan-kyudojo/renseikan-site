---
// The hero: the name written in the logo face and its mon pressed (left, desktop), the title and lede, and 弓道 painted
// in live ink with its seal (right). The wind blows across the whole section. home.js runs the sequence.
// The words come from the Home page document in the Studio (src/lib/pages.ts).
import type { Pages } from '../lib/pages';
interface Props {
  copy: Pages['home']['hero'];
}
const { copy } = Astro.props;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <canvas id="wash" aria-hidden="true"></canvas>
  <div class="wrap">
    <div class="scroll-kanji" aria-hidden="true">
      <div class="kanji" id="heroKanji" lang="ja"></div>
      <span class="hanko stamp" id="hanko"></span>
    </div>
    <div>
      <p class="eyebrow">{copy.eyebrow}</p>
      <div class="kanji inline" id="heroKanjiInline" lang="ja" aria-hidden="true"></div>
      <h1 id="hero-title" class="wipe in late">
        {copy.title}
      </h1>
      <p class="lede">{copy.lede}</p>
      <div class="actions">
        <a class="btn primary" href={copy.primary.href}>
          {copy.primary.label}
        </a>
        <a class="btn secondary" href={copy.secondary.href}>
          {copy.secondary.label}
        </a>
      </div>
    </div>
    <div
      class="ink-stage"
      role="img"
      aria-label="弓道, kyūdō, painted in ink stroke by stroke as the page opens, with a red seal"
    >
      <canvas class="ink" id="inkCanvas"></canvas>
      <canvas class="ink wet" id="wetCanvas" aria-hidden="true"></canvas>
      <span class="seal stamp" id="strokeSeal" aria-hidden="true"></span>
    </div>
  </div>
  <div class="ya-wrap" aria-hidden="true">
    <svg class="ya" viewBox="0 0 24 72">
      <path d="M12 2 V 60"></path>
      <path d="M8 6 L12 12 L16 6 M8 12 L12 18 L16 12"></path>
      <polygon class="tip" points="12,70 8,60 16,60"></polygon>
    </svg>
  </div>
</section>

<script>
  import '../scripts/home.js';
</script>
