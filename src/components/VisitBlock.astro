---
// Hours, address and contact beside the map; site.js swaps the placeholder for the Google Maps embed. The labels come
// from "Navigation and shared text" in the Studio; the facts from Dojo settings and Classes.
import type { Site } from '../lib/sanity';
import { getShared } from '../lib/pages';
interface Props {
  site: Site;
  days: string;
}
const { site, days } = Astro.props;
const a = site.address;
const shared = await getShared();
const copy = shared.visit;
---

<div class="two">
  <dl>
    <div class="row">
      <dt>{copy.hoursLabel}</dt>
      <dd>
        {days}, <span class="nowrap">{site.hours}</span>
      </dd>
    </div>
    <div class="row">
      <dt>{copy.addressLabel}</dt>
      <dd>
        {a.venue}
        <br />
        {a.street}
        <br />
        {a.city}, {a.region} {a.postalCode}
      </dd>
    </div>
    <div class="row">
      <dt>{copy.contactLabel}</dt>
      <dd>
        <span>{site.email}</span>
        <button class="copy" type="button" data-copy={site.email}>
          {shared.copyLabel}
        </button>
      </dd>
    </div>
  </dl>
  <div class="map" id="map">
    <div class="frame" id="mapFrame" aria-hidden="true">
      MAP
    </div>
    <p class="links">
      <a href={site.mapsSearch} target="_blank" rel="noopener">
        {copy.mapLink}
      </a>
      <a href={site.mapsDirections} target="_blank" rel="noopener">
        {copy.directionsLink}
      </a>
    </p>
  </div>
</div>
