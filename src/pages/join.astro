---
// Joining: what happens after the free first lesson, step by step, and the fees. The words come from the Joining page
// document in the Studio; the fees table from Dojo settings (until a row is filled in, the page's own wording shows).
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getSite } from '../lib/sanity';
import { getPage } from '../lib/pages';
import { toHtml } from '../lib/portable';
const [site, copy] = await Promise.all([getSite(), getPage('join')]);
const fees = (site.fees ?? []).filter((f) => f.item && f.amount);
---

<Base title={copy.seoTitle} description={copy.seoDescription}>
  <section id="join-page" class="page" aria-labelledby="join-title">
    <div class="wrap">
      <PageHeader eyebrow={copy.eyebrow} title={copy.title} id="join-title">
        <p class="lede">{copy.lede}</p>
      </PageHeader>

      <ol class="path">
        {copy.steps.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <Fragment set:html={toHtml(s.body)} />
          </li>
        ))}
      </ol>

      <h3>{copy.fees.title}</h3>
      {fees.length ? (
        <table class="fees">
          <thead>
            <tr>
              <th scope="col">Item</th>
              <th scope="col">Amount</th>
              <th scope="col">Note</th>
            </tr>
          </thead>
          <tbody>
            {fees.map((f) => (
              <tr>
                <th scope="row">{f.item}</th>
                <td>{f.amount}</td>
                <td class="muted">{f.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <Fragment set:html={toHtml(copy.fees.empty)} />
      )}

      <div class="actions">
        {copy.buttons.map((b, i) => (
          <a class:list={['btn', i === 0 ? 'primary' : 'secondary']} href={b.href}>
            {b.label}
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
