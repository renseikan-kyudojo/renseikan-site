---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ClassList from '../components/ClassList.astro';
import BookingPanel from '../components/BookingPanel.astro';
import { getSite, getClasses, getClassDates, daysLabel } from '../lib/sanity';
const [site, classes, dates] = await Promise.all([getSite(), getClasses(), getClassDates()]);
const days = daysLabel(classes);
---

<Base
  title="Classes and booking"
  description={`Kyudo classes ${days} ${site.hours} at JACC in San Jose. New students walk in; members book through JACC on WellnessLiving.`}
>
  <section id="classes-page" class="page" aria-labelledby="classes-title">
    <div class="wrap">
      <PageHeader eyebrow="Classes" title={`${days}, ${site.hours}`} id="classes-title">
        <div class="kanji page-kanji" id="pageKanji" lang="ja" aria-hidden="true"></div>
        <p class="lede">{site.policy}</p>
      </PageHeader>
      <h3>Coming up</h3>
      <ClassList dates={dates} />
      <h3>What to wear and bring</h3>
      <p>Loose clothing you can kneel in and socks. The dojo lends the bow, glove and arrows for the first lessons.</p>
      <BookingPanel site={site} headingTag="h3" />
    </div>
  </section>
</Base>

<script>
  import RenseikanLogo from '../lib/ink/logo.js';
  const el = document.getElementById('pageKanji');
  if (el) RenseikanLogo.kanji(el, { text: '弓道場', direction: 'row', mode: 'strokes', charDuration: 900, delay: 300 });
</script>
