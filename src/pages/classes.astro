---
// Classes: the next dates, what to wear, and booking. The words come from the Classes page document in the Studio.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ClassList from '../components/ClassList.astro';
import BookingPanel from '../components/BookingPanel.astro';
import { getSite, getClassDates } from '../lib/sanity';
import { getPage } from '../lib/pages';
import { toHtml } from '../lib/portable';
const [site, dates, copy] = await Promise.all([getSite(), getClassDates(), getPage('classes')]);
---

<Base title={copy.seoTitle} description={copy.seoDescription}>
  <section id="classes-page" class="page" aria-labelledby="classes-title">
    <div class="wrap">
      <PageHeader eyebrow={copy.eyebrow} title={copy.title} id="classes-title">
        <div class="kanji page-kanji" id="pageKanji" lang="ja" aria-hidden="true"></div>
        <p class="lede">{copy.lede}</p>
      </PageHeader>
      <h3>{copy.comingUpTitle}</h3>
      <ClassList dates={dates} />
      <h3>{copy.wear.title}</h3>
      <Fragment set:html={toHtml(copy.wear.body)} />
      <BookingPanel site={site} headingTag="h3" />
    </div>
  </section>
</Base>

<script>
  import RenseikanLogo from '../lib/ink/logo.js';
  const el = document.getElementById('pageKanji');
  if (el) RenseikanLogo.kanji(el, { text: '弓道場', direction: 'row', mode: 'strokes', charDuration: 900, delay: 300 });
</script>
