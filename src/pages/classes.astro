---
import Base from '../layouts/Base.astro';
import { getSite, getClasses, getClassDates, daysLabel } from '../lib/sanity';
import { classRows, widgetSlot } from '../lib/render';
const [site, classes, dates] = await Promise.all([getSite(), getClasses(), getClassDates()]);
const days = daysLabel(classes);
---
<Base title="Classes and booking" description={`Kyudo classes ${days} ${site.hours} at JACC in San Jose. New students walk in; members book through JACC on WellnessLiving.`}>
<section id="classes-page" aria-labelledby="classes-title">
  <div class="wrap">
    <p class="eyebrow">Classes</p>
    <h2 id="classes-title" class="wipe">{days}, {site.hours}</h2>
    <div class="kanji" id="pageKanji" lang="ja" aria-hidden="true" style="font-size:40px"></div>
    <p class="lede">{site.policy}</p>
    <h3>Coming up</h3>
    <Fragment set:html={classRows(dates)} />
    <h3>What to wear and bring</h3>
    <p>Loose clothing you can kneel in and socks. The dojo lends the bow, glove and arrows for the first lessons.</p>
    <h3>Members' booking</h3>
    <div class="panel" id="book">
      <p class="eyebrow">Members' booking</p>
      <p class="muted">New students don't need to book. Members reserve their place through the Japanese Art &amp; Cultural Center (JACC) on WellnessLiving.</p>
      <Fragment set:html={widgetSlot(site)} /><!-- JACC Custom Schedule widget: pasted into Dojo settings in the Studio (runbook 06) -->
      <div class="actions" style="align-items:center">
        <a class="btn primary" href={site.booking} target="_blank" rel="noopener">Book on WellnessLiving</a>
        <p class="note">Opens the JACC schedule in a new tab.</p>
      </div>
    </div>
  </div>
</section>
<script is:inline>
  // the ink libraries load at the end of the body, so wait for the DOM
  addEventListener('DOMContentLoaded', function () { if (window.RenseikanLogo) RenseikanLogo.kanji(document.getElementById('pageKanji'), { text: '弓道場', direction: 'row', mode: 'strokes', charDuration: 900, delay: 300 }); });
</script>
</Base>
