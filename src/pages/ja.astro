---
// 日本語の案内ページ: the essentials in Japanese for visiting kyudoka and the JACC community. The words come from the
// Japanese page document in the Studio; {days} and {hours} are filled in Japanese here.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getSite, getClasses, getInstructors } from '../lib/sanity';
import { getPage } from '../lib/pages';
import { toHtml } from '../lib/portable';
const [site, classes, instructors] = await Promise.all([getSite(), getClasses(), getInstructors()]);
const chief = instructors[0];
const JA: Record<string, string> = {
  Sunday: '日曜日',
  Monday: '月曜日',
  Tuesday: '火曜日',
  Wednesday: '水曜日',
  Thursday: '木曜日',
  Friday: '金曜日',
  Saturday: '土曜日',
};
const days =
  [...new Set(classes.filter((c) => c.status !== 'Cancelled').map((c) => JA[c.weekday] ?? c.weekday))].join('・') ||
  '日曜日';
const hours =
  site.hours.replace(/\s*(am|pm)\s*$/i, '').replace(/–|-/, '〜') + (/pm\s*$/i.test(site.hours) ? '（午後）' : '');
const copy = await getPage('ja', { days, hours });
const a = site.address;
---

<Base lang="ja" title={copy.seoTitle} description={copy.seoDescription}>
  <section id="ja-page" class="page" aria-labelledby="ja-title" lang="ja">
    <div class="wrap">
      <PageHeader eyebrow={copy.eyebrow} title={copy.title} id="ja-title">
        <p class="lede">{copy.lede}</p>
      </PageHeader>
      <dl>
        <div class="row">
          <dt>{copy.labels.days}</dt>
          <dd>{copy.daysText}</dd>
        </div>
        <div class="row">
          <dt>{copy.labels.place}</dt>
          <dd>
            {a.venue}
            <br />
            {a.street}
            <br />
            {a.city}, {a.region} {a.postalCode}
          </dd>
        </div>
        <div class="row">
          <dt>{copy.labels.teacher}</dt>
          <dd>
            {chief.name}
            {chief.rank && <span>（{chief.rank === 'Renshi Rokudan' ? '錬士六段' : chief.rank}）</span>}
          </dd>
        </div>
        <div class="row">
          <dt>{copy.labels.contact}</dt>
          <dd>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </dd>
        </div>
        <div class="row">
          <dt>{copy.labels.affiliation}</dt>
          <dd>{copy.affiliation}</dd>
        </div>
      </dl>
      {copy.sections.map((s) => (
        <>
          <h3>{s.title}</h3>
          <Fragment set:html={toHtml(s.body)} />
        </>
      ))}
      <div class="actions">
        {copy.buttons.map((b, i) => (
          <a class:list={['btn', i === 0 ? 'primary' : 'secondary']} href={b.href}>
            {b.label}
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
