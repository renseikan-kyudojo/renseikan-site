---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import VisitBlock from '../components/VisitBlock.astro';
import { getSite, getClasses, daysLabel } from '../lib/sanity';
const [site, classes] = await Promise.all([getSite(), getClasses()]);
const days = daysLabel(classes);
const a = site.address;
---

<Base
  title="Visit"
  description={`${a.street}, ${a.city}, ${a.region} ${a.postalCode}. ${days} ${site.hours}. New students walk in; no appointment needed.`}
>
  <section id="visit-page" class="page" aria-labelledby="visit-title">
    <div class="wrap">
      <PageHeader eyebrow="Visit" title="Visit the dojo" id="visit-title">
        <p class="lede">{site.policy}</p>
      </PageHeader>
      <VisitBlock site={site} days={days} />
    </div>
  </section>
</Base>
