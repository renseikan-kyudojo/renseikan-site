---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
const a = site.address;
---
<Base title="Visit" description={`${a.street}, ${a.city}, ${a.region} ${a.postalCode}. Sundays ${site.hours}. Walk in any Sunday; no appointment needed.`}>
<section id="visit-page" aria-labelledby="visit-title">
  <div class="wrap">
    <p class="eyebrow">Visit</p>
    <h2 id="visit-title" class="wipe">Visit the dojo</h2>
    <p class="notice">{site.policy}</p>
    <div class="two">
      <dl>
        <div class="row"><dt>Hours</dt><dd>Sundays, {site.hours}<small>New students: walk in any Sunday to observe or take a free trial lesson. No appointment needed.</small></dd></div>
        <div class="row"><dt>Address</dt><dd>{a.street}<br>{a.city}, {a.region} {a.postalCode}</dd></div>
        <div class="row"><dt>Contact</dt><dd><span>{site.email}</span><button class="copy" type="button" data-copy={site.email}>Copy</button></dd></div>
      </dl>
      <div class="map" id="map">
        <div class="frame" id="mapFrame" aria-hidden="true">MAP</div>
        <p class="links"><a href={site.mapsSearch} target="_blank" rel="noopener">Open in Google Maps</a><a href={site.mapsDirections} target="_blank" rel="noopener">Directions</a></p>
      </div>
    </div>
  </div>
</section>
</Base>
