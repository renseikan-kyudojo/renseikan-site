---
// About: the name, the history, what a class looks like, the affiliation. Every section comes from the About page
// document in the Studio.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getPage } from '../lib/pages';
import { toHtml } from '../lib/portable';
const copy = await getPage('about');
---

<Base title={copy.seoTitle} description={copy.seoDescription}>
  <section id="about" class="page" aria-labelledby="about-title">
    <div class="wrap">
      <div class="about-mon" id="aboutMon" aria-hidden="true"></div>
      <PageHeader eyebrow={copy.eyebrow} title={copy.title} id="about-title">
        <p class="lede">{copy.lede}</p>
      </PageHeader>
      {copy.sections.map((s) => (
        <>
          <h3>{s.title}</h3>
          <Fragment set:html={toHtml(s.body)} />
        </>
      ))}
    </div>
  </section>
</Base>
