---
// Not found. The words come from the Not-found page document in the Studio.
import Base from '../layouts/Base.astro';
import { getPage } from '../lib/pages';
const copy = await getPage('notFound');
---

<Base title={copy.seoTitle} description={copy.seoDescription}>
  <section class="page nf" aria-labelledby="nf-title">
    <div class="wrap">
      <div id="nfMon" class="nf-mon" aria-hidden="true"></div>
      <h1 id="nf-title" class="page-title">
        {copy.title}
      </h1>
      <p class="muted">
        {copy.text}{' '}
        <a class="nf-link" href="/">
          {copy.linkLabel}
        </a>
        .
      </p>
    </div>
  </section>
</Base>

<script>
  import RenseikanLogo from '../lib/ink/logo.js';
  const el = document.getElementById('nfMon');
  if (el) RenseikanLogo.mon(el, { mode: 'ink' });
</script>
