---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="That page is not here.">
  <section class="page nf" aria-labelledby="nf-title">
    <div class="wrap">
      <div id="nfMon" class="nf-mon" aria-hidden="true"></div>
      <h1 id="nf-title" class="page-title">
        That page is not here
      </h1>
      <p class="muted">
        The arrow went past the target.{' '}
        <a class="nf-link" href="/">
          Back to the dojo
        </a>
        .
      </p>
    </div>
  </section>
</Base>

<script>
  import RenseikanLogo from '../lib/ink/logo.js';
  const el = document.getElementById('nfMon');
  if (el) RenseikanLogo.mon(el, { mode: 'ink' });
</script>
