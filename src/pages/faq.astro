---
// Questions new students ask. Entries come from the Studio (FAQ entries); the built-in ones in src/data/pages.json
// show until the first is published. Rendered as <details> so every answer is reachable without JS, with FAQPage
// schema.org data. Placeholders such as {days} in an answer are filled in like everywhere else.
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { getFaqs } from '../lib/sanity';
import { getPage, getVars, defaults } from '../lib/pages';
import { fillDeep } from '../lib/copy.js';
import { toHtml, toInlineHtml, toText } from '../lib/portable';
const [copy, vars] = await Promise.all([getPage('faq'), getVars()]);
const faqs = fillDeep(await getFaqs(defaults.faq.entries), vars);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: toText(f.answer) },
  })),
};
---

<Base title={copy.seoTitle} description={copy.seoDescription}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  <section id="faq-page" class="page" aria-labelledby="faq-title">
    <div class="wrap">
      <PageHeader eyebrow={copy.eyebrow} title={copy.title} id="faq-title">
        <p class="lede" set:html={toInlineHtml(copy.lede)} />
      </PageHeader>
      <div class="faq">
        {faqs.map((f) => (
          <details name="faq">
            <summary>
              <h3>{f.question}</h3>
            </summary>
            <div class="answer" set:html={toHtml(f.answer)} />
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>
