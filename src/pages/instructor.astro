---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import InstructorCard from '../components/InstructorCard.astro';
import { getInstructors } from '../lib/sanity';
const instructors = await getInstructors();
const t = instructors[0];
const desc = [t.name, t.rank, t.credentials[0]].filter(Boolean).join(', ') + '.';
const label = instructors.length > 1 ? 'Instructors' : 'Instructor';
---

<Base title={label} description={desc}>
  <section id="instructor-page" class="page" aria-labelledby="instr-title">
    <div class="wrap">
      <PageHeader eyebrow={label} title="Who teaches here" id="instr-title" />
      <div class="cards">
        {instructors.map((p, i) => (
          <InstructorCard person={p} headingTag="h2" eager={i === 0} />
        ))}
      </div>
    </div>
  </section>
</Base>
