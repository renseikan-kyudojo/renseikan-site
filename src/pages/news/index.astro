---
// News: upcoming events, then posts, newest first. Each links to its own page. The words come from the News page
// document in the Studio.
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getEvents, getPosts } from '../../lib/sanity';
import { getPage } from '../../lib/pages';
import { toInlineHtml } from '../../lib/portable';
import { when } from '../../lib/format';
const [events, posts, copy] = await Promise.all([getEvents(), getPosts(), getPage('news')]);
---

<Base title={copy.seoTitle} description={copy.seoDescription}>
  <section id="news-page" class="page" aria-labelledby="news-title">
    <div class="wrap">
      <PageHeader eyebrow={copy.eyebrow} title={copy.title} id="news-title">
        <p class="lede" set:html={toInlineHtml(copy.lede)} />
      </PageHeader>
      {events.length === 0 && <p class="muted">{copy.empty}</p>}
      <ul class="events">
        {events.map((e) => (
          <li>
            <p class="meta">
              <time datetime={e.date}>{when(e.date)}</time>
              {e.endDate && e.endDate !== e.date && <span> to {when(e.endDate)}</span>}
              {e.place && <span> · {e.place}</span>}
              {e.kind && e.kind !== 'Other' && <span> · {e.kind}</span>}
            </p>
            <h2>
              <a href={`/events/${e.slug}`}>{e.title}</a>
            </h2>
            {e.summary && <p>{e.summary}</p>}
          </li>
        ))}
      </ul>
      {posts.length > 0 && (
        <>
          <h3>{copy.postsTitle}</h3>
          <ul class="events">
            {posts.map((p) => (
              <li>
                <p class="meta">
                  <time datetime={p.date}>{when(p.date)}</time>
                </p>
                <h2>
                  <a href={`/news/${p.slug}`}>{p.title}</a>
                </h2>
                {p.summary && <p>{p.summary}</p>}
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
  </section>
</Base>
